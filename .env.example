# ---- shared ----
APP_ENV=dev
LOG_LEVEL=info

# state: memory | redis
STATE_DRIVER=memory
REDIS_ADDR=127.0.0.1:6379

# queue: memory | rabbitmq
QUEUE_DRIVER=memory
QUEUE_URL=amqp://guest:guest@127.0.0.1:5672/

# auth
JWT_SECRET=nexusflow-dev-secret
ALLOW_ANONYMOUS=true
# token revocation list: memory (per-process, dev) | redis (shared by gateway and auth-service)
TOKEN_BLACKLIST_DRIVER=memory
# identity: token lifetime + self-service registration + seeded admin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ALLOW_SELF_REGISTER=true
SEED_TENANT_ID=default
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
# user/role store: memory (dev-all) | redis | postgres (shared across auth/user services)
# deploy/docker-compose.yml defaults to postgres for auth-service + user-service.
IDENTITY_DRIVER=memory
# required when IDENTITY_DRIVER=postgres, e.g.
# postgresql://nexusflow:nexusflow@127.0.0.1:5432/nexusflow
# The identity schema and seed admin are created idempotently on first start.
IDENTITY_DATABASE_URL=

# object storage
OBJECT_STORE_DIR=/tmp/nexusflow-objects
OBJECT_STORE_BASE=http://127.0.0.1:9000/nexusflow
# comma-separated hosts allowed for presigned upload URLs (SSRF guard);
# empty -> derived from OBJECT_STORE_BASE
OBJECT_STORE_ALLOWED_HOSTS=

# MinerU 4.x V1 Tasks API (empty -> built-in mock parser)
# Local Docker API: http://mineru-api:8000
MINERU_TARGET=
MINERU_API_KEY=
MINERU_TIER=standard
PARSE_MAX_ATTEMPTS=3

# sandbox: local | remote
SANDBOX_BACKEND=local
# local is not a security boundary; prod refuses to start with it unless this
# is explicitly set to true.
SANDBOX_ALLOW_LOCAL=false
SANDBOX_WORK_DIR=/tmp/nexusflow-sandboxes
OPENSANDBOX_URL=
OPENSANDBOX_TOKEN=

# gateway downstream targets (only needed when running services separately)
INGESTION_TARGET=127.0.0.1:9095
QUERY_TARGET=127.0.0.1:9094
SANDBOX_TARGET=127.0.0.1:9093
AUTH_TARGET=127.0.0.1:9096
USER_TARGET=127.0.0.1:9097

# retrieval
# Rerank protocol: generic (bge / Cohere style) | dashscope (Aliyun text-rerank).
RERANK_URL=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_PROTOCOL=generic
RERANK_API_KEY=
# Candidate pool sent to the reranker (0 = every fused candidate).
RERANK_POOL=0
RERANK_TIMEOUT=8s
# LlamaIndex service used by query-service (vector/bm25/graph recall) and
# processing-worker (indexing). Empty -> query-service serves the in-memory demo
# corpus and indexing is skipped. compose sets http://llamaindex:8000.
# e.g. LLAMAINDEX_URL=http://127.0.0.1:8000
LLAMAINDEX_URL=

# metrics (empty -> disabled)
METRICS_ADDR=

# observability / tracing (Langfuse)
# Leave LANGFUSE_BASE_URL empty to disable export. TRACING_MEMORY defaults on
# in dev (APP_ENV=dev) and powers the in-app trace viewer.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACING_MEMORY=

# ---- LlamaIndex service ----
LLAMAINDEX_QDRANT_URL=http://127.0.0.1:6333
# Qdrant native sparse (IDF) lexical recall for the bm25 route. When disabled
# or the companion sparse collection is missing, retrieval falls back to the
# legacy Qdrant scroll + BM25 implementation.
LLAMAINDEX_SPARSE_ENABLED=true
LLAMAINDEX_EMBEDDING_API_KEY=
LLAMAINDEX_EMBEDDING_API_BASE=https://api.openai.com/v1
LLAMAINDEX_EMBEDDING_MODEL=text-embedding-3-large
LLAMAINDEX_EMBEDDING_BATCH_SIZE=16
# Rerank used by the /v1/search pipeline when the request specifies a model.
LLAMAINDEX_RERANK_URL=
LLAMAINDEX_RERANK_MODEL=bge-reranker-v2-m3
LLAMAINDEX_RERANK_PROTOCOL=generic
LLAMAINDEX_RERANK_API_KEY=
LLAMAINDEX_RERANK_POOL=0
LLAMAINDEX_RERANK_TIMEOUT_SECONDS=2
# LLM used by the LightRAG-style graph route for entity/relation extraction.
# Empty (or a failed call) -> automatic co-occurrence word graph fallback.
LLAMAINDEX_LLM_BASE_URL=
LLAMAINDEX_LLM_API_KEY=
LLAMAINDEX_LLM_MODEL=gpt-4o-mini
# Per-scope graph cache TTL (new chunks invalidate it on indexing).
LLAMAINDEX_GRAPH_CACHE_SECONDS=60
# Persistent graph snapshots: memory (process cache) | postgres (shared by
# replicas in rag_graph_snapshots; requires LLAMAINDEX_GRAPH_DATABASE_URL).
LLAMAINDEX_GRAPH_STORE_DRIVER=memory
LLAMAINDEX_GRAPH_DATABASE_URL=
# Real LightRAG (lightrag-hku >= 1.5.8), opt-in. Needs an OpenAI-compatible LLM
# (LLAMAINDEX_LLM_*). storage_driver=postgres uses PGKV/PGVector/PGDocStatus
# plus PGTableGraphStorage (plain tables, no Apache AGE); set
# PGGraphStorage only when the database has AGE installed.
LLAMAINDEX_LIGHTRAG_ENABLED=false
LLAMAINDEX_LIGHTRAG_STORAGE_DRIVER=file
LLAMAINDEX_LIGHTRAG_GRAPH_STORAGE=
LLAMAINDEX_LIGHTRAG_WORKING_DIR=/tmp/nexusflow-lightrag
LLAMAINDEX_LIGHTRAG_QUERY_MODE=hybrid
LLAMAINDEX_LIGHTRAG_EMBEDDING_DIM=1536
LLAMAINDEX_LIGHTRAG_TOP_K=40
# LightRAG PG storages read these standard variables when storage_driver=postgres.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=nexusflow
# POSTGRES_PASSWORD=nexusflow
# POSTGRES_DATABASE=nexusflow

# ---- Agent hub (RAG chat + intent / summary / memory) ----
# One image, one default container. ROLE=all runs every agent in-process;
# ROLE=intent|summary|memory runs a split worker on the same image.
AGENT_HUB_ROLE=all
# local: all agents in-process; remote: call split workers; hybrid: both.
AGENT_HUB_MODE=local
AGENT_HUB_PREFER=local
AGENT_HUB_PORT=8001
AGENT_HUB_HEALTH_INTERVAL_SECONDS=10
AGENT_HUB_HEALTH_TIMEOUT_SECONDS=2
AGENT_HUB_REGISTRY_TTL_SECONDS=30
AGENT_HUB_FAIL_THRESHOLD=3
AGENT_HUB_MAX_ATTEMPTS=2
# Dynamic registration is off by default. Enable + set an admin token to use
# the console's "SubAgent 管理" page; the gateway forwards AGENT_HUB_TOKEN.
AGENT_HUB_DYNAMIC_REGISTRATION=false
AGENT_HUB_ADMIN_TOKEN=
# Custom SubAgent registry: memory (dev) | postgres (durable, multi-replica).
# Postgres mode idempotently creates custom_agents on startup.
AGENT_HUB_REGISTRY_DRIVER=memory
AGENT_HUB_REGISTRY_DATABASE_URL=
# HITL approval tickets and the audit trail: memory (dev) | postgres (shared
# across replicas). Both use AGENT_HUB_STATE_DATABASE_URL.
AGENT_HUB_APPROVAL_DRIVER=memory
AGENT_HUB_AUDIT_DRIVER=memory
# Whole months older than this are dropped from partitioned audit_logs
# (0 keeps everything; 180 ~ the 6-month compliance baseline).
AGENT_HUB_AUDIT_RETENTION_DAYS=180
AGENT_HUB_STATE_DATABASE_URL=
AGENT_HUB_BACKGROUND_WORKERS=8
# Gateway -> agent hub base URL (empty disables /v1/chat).
RAG_AGENT_URL=http://127.0.0.1:8001
# agent hub -> gateway for retrieval.
RAG_GATEWAY_URL=http://127.0.0.1:8080
# Conversation persistence; empty -> in-memory (dev only).
RAG_DATABASE_URL=
# OpenAI-compatible LLM; leave base_url/api_key empty for extractive fallback.
# DeepSeek example (OpenAI compatible):
#   RAG_LLM_BASE_URL=https://api.deepseek.com/v1
#   RAG_LLM_MODEL=deepseek-chat
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=gpt-4o-mini
# PII shielding at the LLM boundary: mask prompts/context with stable tokens.
# Replies stay masked unless RAG_PII_RESTORE_OUTPUT=true.
RAG_PII_ENABLED=false
RAG_PII_RESTORE_OUTPUT=false
RAG_DEFAULT_TOP_K=5
# Used by AGENT_HUB_MODE=remote|hybrid; local mode ignores these URLs.
# Remote intent worker (empty/unreachable -> knowledge QA).
RAG_INTENT_URL=http://127.0.0.1:8002
RAG_INTENT_TIMEOUT_SECONDS=5
# Historical corrected answers matched before retrieval via the gateway
# (/v1/corrected-answers); lookup failure -> plain RAG without corrections.
RAG_CORRECTED_TIMEOUT_SECONDS=5
RAG_CORRECTED_TOP_K=3
# Remote summary worker for context compaction (empty/unreachable -> no
# compaction; older turns simply fall out of the window).
RAG_SUMMARY_URL=http://127.0.0.1:8003
RAG_SUMMARY_TIMEOUT_SECONDS=10
RAG_SUMMARY_BUDGET_CHARS=1200
# Messages kept verbatim once older turns are folded into the summary.
RAG_SUMMARY_RECENT_MESSAGES=6
# Remote memory worker for long-term recall (empty/unreachable -> none).
RAG_MEMORY_URL=http://127.0.0.1:8004
RAG_MEMORY_TIMEOUT_SECONDS=5
RAG_MEMORY_TOP_K=3

# ---- Intent agent (in-process, or split worker ROLE=intent :8002) ----
# OpenAI-compatible model for intent classification; leave empty to use rules.
# DeepSeek example:
#   INTENT_LLM_BASE_URL=https://api.deepseek.com/v1
#   INTENT_LLM_MODEL=deepseek-chat
INTENT_LLM_BASE_URL=
INTENT_LLM_API_KEY=
INTENT_LLM_MODEL=deepseek-chat

# ---- Summary agent (in-process, or split worker ROLE=summary :8003) ----
# OpenAI-compatible model for rolling summaries; leave empty for extractive.
# DeepSeek example:
#   SUMMARY_LLM_BASE_URL=https://api.deepseek.com/v1
#   SUMMARY_LLM_MODEL=deepseek-chat
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_MODEL=deepseek-chat
SUMMARY_BUDGET_CHARS=1200

# ---- Memory agent (in-process, or split worker ROLE=memory :8004) ----
# Empty LLM key -> rule-based extraction; empty embedding key -> lexical recall.
# DeepSeek / OpenAI-compatible examples:
#   MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
#   MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=deepseek-chat
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model output dimension (Qdrant vector size).
MEMORY_EMBEDDING_DIM=1536
# Postgres stores memory content; Qdrant stores memory vectors.
# memory | postgres | qdrant. Empty -> auto: DB + Qdrant -> qdrant,
# DB only -> postgres (legacy pgvector), otherwise memory.
MEMORY_DRIVER=
MEMORY_DATABASE_URL=
MEMORY_QDRANT_URL=
MEMORY_QDRANT_COLLECTION=nexusflow_memories
MEMORY_TOP_K=3
# Legacy pgvector index tuning (only for MEMORY_DRIVER=postgres; ignored by qdrant).
# hnsw: better recall, higher build cost; ivfflat: cheaper, build after data;
# none: exact scan (fine for small per-user datasets).
MEMORY_VECTOR_INDEX=hnsw
# Drop + recreate the index so changed parameters take effect.
MEMORY_VECTOR_INDEX_RECREATE=false
MEMORY_HNSW_M=16
MEMORY_HNSW_EF_CONSTRUCTION=64
MEMORY_HNSW_EF_SEARCH=40
MEMORY_IVFFLAT_LISTS=100
MEMORY_IVFFLAT_PROBES=10

# ---- feedback persistence ----
# memory (dev) | postgres (durable; compose uses postgres)
FEEDBACK_DRIVER=memory
# Empty with driver=postgres -> startup fails instead of silently dropping feedback.
FEEDBACK_DATABASE_URL=

# ---- tenant API keys (OpenAI-compatible endpoint) ----
# memory (dev; keys vanish on restart) | postgres (durable api_keys table)
API_KEY_DRIVER=memory
API_KEY_DATABASE_URL=

# ---- tenant event webhooks ----
# memory (dev) | postgres (durable webhooks / webhook_deliveries)
WEBHOOK_DRIVER=memory
WEBHOOK_DATABASE_URL=
# Encrypts HMAC signing secrets at rest; falls back to CONNECTOR_ENCRYPTION_KEY.
WEBHOOK_ENCRYPTION_KEY=
# Shared token for POST /v1/internal/events; empty disables event ingest.
WEBHOOK_EVENTS_TOKEN=
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE=1s
# Allow loopback/private target URLs (local receivers). Defaults to true when
# APP_ENV != prod; set false in production to block SSRF.
WEBHOOK_ALLOW_PRIVATE=false
# Optional host allowlist for delivery targets: exact hosts or "*.suffix"
# wildcards, comma separated. Empty means only the private-address check applies.
WEBHOOK_ALLOWED_HOSTS=
# Workers publish events back to the gateway at this address.
GATEWAY_URL=http://127.0.0.1:8080

# ---- NL2SQL workflow node ----
# Read-only structured query database. Never use a write-capable role in production.
NL2SQL_DATABASE_URL=
NL2SQL_MAX_ROWS=200
NL2SQL_TIMEOUT=5s
# Table/column description injected into the question -> SQL prompt.
NL2SQL_SCHEMA=
# OpenAI-compatible LLM for NL -> SQL. Empty -> only config.sql / sql_from works.
NL2SQL_LLM_BASE_URL=
NL2SQL_LLM_API_KEY=
NL2SQL_LLM_MODEL=gpt-4o-mini

# ---- Agent hub: tools / reasoning / MCP / HITL ----
# All capability switches default off; turn them on in order and roll back by
# switching them off again (the legacy /v1/chat path keeps working).
AGENT_HUB_TOOLS_ENABLED=false
AGENT_HUB_REASONING_ENABLED=false
# MCP server: Streamable HTTP (POST /mcp, GET /mcp notifications, DELETE /mcp),
# legacy SSE (GET /mcp/sse + POST /mcp/messages), and stdio
# (`python -m nexusflow_agents.mcp.stdio`) for local clients.
AGENT_HUB_MCP_ENABLED=false
AGENT_HUB_HITL_ENABLED=false
AGENT_HUB_WORKFLOW_ENABLED=false
# Go workflow engine used by the `workflow.run` tool.
AGENT_HUB_WORKFLOW_URL=http://127.0.0.1:8081
AGENT_HUB_WORKFLOW_SERVICE_TOKEN=
AGENT_HUB_WORKFLOW_TIMEOUT_SECONDS=15
# Multi-turn reasoning budgets.
AGENT_HUB_REASONING_MAX_TURNS=6
AGENT_HUB_REASONING_TIMEOUT_SECONDS=60
AGENT_HUB_REASONING_TOOL_BUDGET=12
AGENT_HUB_REASONING_TOKEN_BUDGET=20000
# Per-tool timeout and progress heartbeat in the streaming reasoning loop.
AGENT_HUB_REASONING_TOOL_TIMEOUT_SECONDS=30
AGENT_HUB_REASONING_TOOL_PROGRESS_SECONDS=2
# MCP client: comma-separated name=url entries. Tools become mcp.<server>.<tool>.
AGENT_HUB_MCP_SERVERS=
AGENT_HUB_MCP_TIMEOUT_SECONDS=10
AGENT_HUB_MCP_MAX_BYTES=1048576
AGENT_HUB_MCP_ALLOW_SANDBOX=false
# Streamable HTTP session metadata: memory (dev) | postgres (shared across
# replicas, uses AGENT_HUB_STATE_DATABASE_URL).
AGENT_HUB_MCP_SESSION_DRIVER=memory
AGENT_HUB_MCP_SESSION_TTL_SECONDS=86400

# ---- Workflow engine (Go DAG) ----
WORKFLOW_HTTP_ADDR=:8081
# Gateway -> workflow engine. Set the same token on both sides to stop direct
# access that bypasses gateway RBAC.
WORKFLOW_TARGET=http://127.0.0.1:8081
WORKFLOW_SERVICE_TOKEN=
# Register the DAG -> Agent Hub node (`agent` type).
WORKFLOW_AGENT_NODE=false
# Agent hub endpoint used by the DAG agent node and Gateway proxies.
AGENT_HUB_URL=http://127.0.0.1:8001
# Keep equal to AGENT_HUB_ADMIN_TOKEN when the hub token is configured.
AGENT_HUB_TOKEN=
AGENT_HUB_TIMEOUT=30s
# human_approval node + /v1/workflows/runs persistence and approval resume.
HITL_ENABLED=false
# Run/approval persistence: memory (dev) | postgres (survives restart and is
# shared by replicas). Postgres idempotently creates workflow_executions and
# workflow_approvals on startup.
WORKFLOW_RUN_STORE_DRIVER=memory
WORKFLOW_RUN_DATABASE_URL=

# ---- External data connectors (ingestion HTTP API) ----
# Connector definitions/cursors: memory (dev) | postgres (data_connectors).
CONNECTOR_DRIVER=memory
CONNECTOR_DATABASE_URL=
# AES-GCM key for configs at rest. Empty stores plaintext and is dev-only.
CONNECTOR_ENCRYPTION_KEY=
# Internal ingestion HTTP listener; the gateway proxies /v1/connectors here.
INGESTION_HTTP_ADDR=:9098
CONNECTOR_TARGET=http://127.0.0.1:9098
# Cron scheduler for connectors (5-field expressions, e.g. "0 */6 * * *").
# Each due run is claimed in the store so replicas do not double-fire.
CONNECTOR_SCHEDULER_ENABLED=true
CONNECTOR_SCHEDULER_INTERVAL=30s
CONNECTOR_SYNC_TIMEOUT=10m

# ---- LLM router (OpenAI-compatible) ----
# Point RAG_LLM_BASE_URL / INTENT_LLM_BASE_URL / SUMMARY_LLM_BASE_URL at
# http://llm-gateway:8082/v1 to route through it.
LLM_GATEWAY_PUBLISH_PORT=8082
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
# Per-tenant daily tokens; 0 means unlimited. Quota counters live in Redis.
LLM_DAILY_TOKEN_LIMIT=0
LLM_QUOTA_DRIVER=redis
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN=30s
LLM_UPSTREAM_TIMEOUT=120s

# ---- Postgres (docker-compose) ----
POSTGRES_PASSWORD=nexusflow
