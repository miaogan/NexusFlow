# ---- shared ----
APP_ENV=dev
LOG_LEVEL=info

# state: memory | redis
STATE_DRIVER=memory
REDIS_ADDR=127.0.0.1:6379

# queue: memory | rabbitmq
QUEUE_DRIVER=memory
QUEUE_URL=amqp://guest:guest@127.0.0.1:5672/

# auth
JWT_SECRET=nexusflow-dev-secret
ALLOW_ANONYMOUS=true
# identity: token lifetime + self-service registration + seeded admin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ALLOW_SELF_REGISTER=true
SEED_TENANT_ID=default
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# object storage
OBJECT_STORE_DIR=/tmp/nexusflow-objects
OBJECT_STORE_BASE=http://127.0.0.1:9000/nexusflow

# MinerU (empty -> built-in mock parser)
MINERU_TARGET=
PARSE_MAX_ATTEMPTS=3

# sandbox: local | remote
SANDBOX_BACKEND=local
SANDBOX_WORK_DIR=/tmp/nexusflow-sandboxes
OPENSANDBOX_URL=
OPENSANDBOX_TOKEN=

# gateway downstream targets (only needed when running services separately)
INGESTION_TARGET=127.0.0.1:9095
QUERY_TARGET=127.0.0.1:9094
SANDBOX_TARGET=127.0.0.1:9093
AUTH_TARGET=127.0.0.1:9096
USER_TARGET=127.0.0.1:9097

# retrieval
RERANK_URL=
RERANK_MODEL=bge-reranker-v2-m3

# metrics (empty -> disabled)
METRICS_ADDR=

# observability / tracing (Langfuse)
# Leave LANGFUSE_BASE_URL empty to disable export. TRACING_MEMORY defaults on
# in dev (APP_ENV=dev) and powers the in-app trace viewer.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACING_MEMORY=

# ---- LlamaIndex service ----
LLAMAINDEX_QDRANT_URL=http://127.0.0.1:6333
LLAMAINDEX_EMBEDDING_API_KEY=
LLAMAINDEX_EMBEDDING_API_BASE=https://api.openai.com/v1
